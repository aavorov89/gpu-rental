# Copy this file to .env in the project directory. Goose and Docker Compose both read it there.

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://gpu_rental:gpu_rental@127.0.0.1:55432/gpu_rental?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# Keep GOOSE_DBSTRING in sync if you override these Compose defaults.
# POSTGRES_USER=gpu_rental
# POSTGRES_PASSWORD=gpu_rental
# POSTGRES_DB=gpu_rental
# POSTGRES_PORT=55432
